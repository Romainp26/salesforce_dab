{
  "datasets": [
    {
      "name": "runs",
      "displayName": "Runs",
      "queryLines": [
        "SELECT\n",
        "  run_id,\n",
        "  min(started_at) AS started_at,\n",
        "  convert_timezone('Asia/Bangkok', max(ended_at)) AS finished_bangkok,\n",
        "  round((unix_timestamp(max(ended_at)) - unix_timestamp(min(started_at))) / 60, 1) AS duration_minutes,\n",
        "  count(*) AS objects,\n",
        "  sum(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) AS failed_objects,\n",
        "  sum(rows_extracted) AS rows_extracted,\n",
        "  sum(versions_written) AS versions_written\n",
        "FROM run_log\n",
        "WHERE last_stage <> 'backfill'\n",
        "GROUP BY run_id\n"
      ]
    },
    {
      "name": "latest",
      "displayName": "Latest run",
      "queryLines": [
        "SELECT object, status, rows_extracted, sf_count, versions_written, soft_deletes, archivals,\n",
        "  hard_deletes, files_landed, watermark_before, watermark_after,\n",
        "  round((unix_timestamp(ended_at) - unix_timestamp(started_at)) / 60, 1) AS minutes, error_message\n",
        "FROM run_log\n",
        "WHERE run_id = (SELECT max_by(run_id, started_at) FROM run_log WHERE last_stage <> 'backfill')\n"
      ]
    }
  ],
